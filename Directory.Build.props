<Project>
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- THE release number, for every build: the Windows app, the Linux agents and the fleet hub
         all report it (whole-number releases: bump the major only, 117, 118, ...).
         build-installer.ps1 and the in-app update check read it from here.
         DO NOT pin FileVersion/AssemblyVersion anywhere: the update check reads AssemblyVersion
         (GetName().Version.Major), so a pinned AssemblyVersion that lags <Version> makes the
         installed build under-report its version and auto-update in an infinite loop. -->
    <Version>123.0.0</Version>
  </PropertyGroup>
</Project>
